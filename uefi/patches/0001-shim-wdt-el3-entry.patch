diff --git a/shim.c b/shim.c
index 49e3d98..b642a91 100644
--- a/shim.c
+++ b/shim.c
@@ -163,6 +163,9 @@ __attribute__((noreturn)) void exception_report(uint64_t slot)
 __attribute__((noreturn)) void shim_main(uint64_t x0, uint64_t x1,
                                         uint64_t x2, uint64_t x3, uint64_t old_sp)
 {
+    /* Belt and braces: start.S already wrote WDT_MODE, but a reset here is
+     * indistinguishable from a boot loop, so never depend on one write. */
+    watchdog_disable();
     shim_log_init();
     shim_log_event(SHIM_LOG_START, 0);
     uint64_t el = READ_SYSREG(CurrentEL);
@@ -193,8 +196,9 @@ __attribute__((noreturn)) void shim_main(uint64_t x0, uint64_t x1,
     }
     if (el == 4) {
         extern void shim_el1(uint64_t dtb);
-        /* AArch64 Linux Image boot protocol passes the FDT address in x2. */
-        shim_el1(x2);
+        /* AArch64 Linux Image boot protocol passes the FDT address in x0.
+         * (The arm64 Linux head.S documents x0 = DTB; LK follows it.) */
+        shim_el1(x0);
     }
     /* Watchdog disable is attempted at shim entry for diagnostics. */
     stop();
diff --git a/start.S b/start.S
index 35b4f92..02ddb1c 100644
--- a/start.S
+++ b/start.S
@@ -17,24 +17,70 @@ _head:
 .global _start
 _start:
     msr daifset, #0xf
+
+    /* MTK top-rgu watchdog: WDT_MODE = KEY(0x22<<24) | EN=0. This must be
+     * the first MMIO write. Without it every path below - including a
+     * fully successful entry - ends in a watchdog reset that is
+     * indistinguishable from a boot loop. */
+    mov x9, #0x7000
+    movk x9, #0x1000, lsl #16       /* 0x10007000 */
+    movz w10, #0x2200, lsl #16      /* 0x22000000 */
+    str w10, [x9]
+    dsb sy
+
+    /* Preserve the bootloader's entry registers across the EL transition. */
     mov x19, x0
     mov x20, x1
     mov x21, x2
     mov x22, x3
     mov x23, sp
+
+    /* LK with bootopt=64S3 enters at EL3; other builds enter at EL2.
+     * EL1 is normal only when the loader already dropped. */
+    mrs x9, CurrentEL
+    cmp x9, #0xC
+    b.eq el3_drop
+    cmp x9, #0x8
+    b.eq el2_drop
+    cmp x9, #0x4
+    b.ne halt
+    b el1_entry
+
+el3_drop:
+    /* SCR_EL3: NS|RES1[6:4]|HCE|RW(bit10) so EL2 executes AArch64. */
+    ldr x9, =0x571
+    msr scr_el3, x9
+    /* SPSR_EL3: EL2h (M=0b1001), D/A/I/F masked. Returning to EL1h here
+     * would run the EL2 register accesses below at EL1, where they are
+     * undefined and raise an exception the shim cannot see. */
+    ldr x9, =0x3c9
+    msr spsr_el3, x9
+    adr x9, el2_drop
+    msr elr_el3, x9
+    eret
+
+el2_drop:
+    mrs x9, cnthctl_el2
+    orr x9, x9, #3                  /* EL1PCTEN | EL1PCEN */
+    msr cnthctl_el2, x9
+    msr cnthp_ctl_el2, xzr
+    msr cntvoff_el2, xzr
+    mov x9, #(1 << 31)              /* HCR_EL2.RW: EL1 is AArch64 */
+    msr hcr_el2, x9
+    ldr x9, =0x3c5                  /* EL1h, DAIF masked */
+    msr spsr_el2, x9
+    adr x9, el1_entry
+    msr elr_el2, x9
+    eret
+
+/* Reached only in EL1h, with SP_EL1 not yet valid. */
+el1_entry:
     msr spsel, #1
     adr x1, _stack_top
     mov sp, x1
     adr x1, vectors
-    mrs x2, CurrentEL
-    cmp x2, #8
-    b.eq 1f
-    cmp x2, #4
-    b.ne halt
     msr vbar_el1, x1
-    b 2f
-1:  msr vbar_el2, x1
-2:  isb
+    isb
     adr x1, _bss_start
     adr x2, _bss_end
 3:  cmp x1, x2
